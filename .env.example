# Copy to .env and adjust
DATABASE_URL=postgres://hautomate:hautomate@localhost:5432/hautomate
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Set both to enable /admin. Use a unique password (16+ characters) and
# generate a random session secret of at least 32 characters.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional: if SMTP_HOST is empty, enquiries are saved but no email is sent
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hautomate Pro Website <no-reply@example.com>"
ENQUIRY_TO=example@gmail.com
